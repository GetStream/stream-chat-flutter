opt_out_usage

require 'net/http'
require 'shellwords'
require 'json'
require 'securerandom'
require 'fileutils'
require 'timeout'
require File.expand_path('e2e_log', __dir__)
require File.expand_path('e2e_tests', __dir__)
import File.expand_path('Allurefile', __dir__)

mock_server_repo_name = 'stream-chat-test-mock-server'
mock_server_driver_port = ENV['MOCK_DRIVER_PORT'] || '4568'
github_repo = ENV['GITHUB_REPOSITORY'] || 'GetStream/stream-chat-flutter'
e2e_coverage_map_artifact = 'e2e-coverage-map'
@force_check = false
@impact = nil

before_all do
  @impact = impact_analysis
  if is_ci
    setup_ci
    setup_git_config
  end
end

def root_path
  Dir.pwd.sub(/.*\Kfastlane/, '').sub(/.*\Kandroid/, '').sub(/.*\Kios/, '').sub(/.*\K\/\//, '')
end

def repo_root
  File.expand_path('..', root_path)
end

def e2e_selection_path
  "#{root_path}/build/e2e_selection.json"
end

def e2e_coverage_path
  "#{root_path}/build/e2e-coverage"
end

def ios_device?(device)
  device.to_s.match?(/\A[0-9A-F]{8}-[0-9A-F]{4}-/i)
end

# `runs` are `[test file, test names or nil for the whole file]` pairs.
def batch_targets(runs, batch:, batch_count:)
  return runs if batch.nil? || batch_count.to_i <= 1
  return [] if runs.empty?

  count = batch_count.to_i
  index = batch.to_i
  tests_of = E2ETests.list('integration_test').group_by { |id| E2ETests.file(id, 'integration_test') }
                     .transform_values { |ids| ids.map { |id| E2ETests.name(id) } }

  # Split by test, not by file, as the files differ a lot in size: every batch takes an equal,
  # contiguous slice of all the tests in run order, so every batch job computes the same split.
  # A file cut by a slice boundary runs in two `flutter test --name` runs, which costs one more
  # app build and launch. A file with no listed tests (all skipped) counts as one test.
  tests = runs.flat_map { |target, names| (names || tests_of.fetch(target, [nil])).map { |name| [target, name] } }
  slice = tests[(index * tests.size / count)...((index + 1) * tests.size / count)]
          .group_by(&:first)
          .map do |target, items|
            names = items.map(&:last)
            # A whole-file run that stayed in one batch keeps running the whole file.
            whole = runs.to_h[target].nil? && (names == [nil] || names == tests_of[target])
            [target, whole ? nil : names]
          end

  if slice.empty?
    UI.important("Batch #{index + 1}/#{count}: no runs fell into this batch — nothing to run")
  else
    UI.important("Batch #{index + 1}/#{count}: #{slice.size} runs, #{slice.sum { |target, names| (names || tests_of.fetch(target, [nil])).size }} of #{tests.size} tests " \
                 "(#{slice.map { |target, names| names ? "#{File.basename(target)}: #{names.join(', ')}" : File.basename(target) }.join('; ')})")
  end

  slice
end

# The entrypoint combine_runs generates, relative to the app (gitignored).
BATCH_ENTRYPOINT = 'integration_test/e2e_batch.g.dart'

# Turns a batch's runs into one run of a generated entrypoint that calls every test file's
# `main()`, so the batch builds and launches the app once instead of once per file. The
# trade-off is the blast radius: a test that leaks async work can now fail the rest of the
# batch, not just the rest of its file. Returns `[entrypoint, test names or nil, test files]`.
def combine_runs(runs)
  files = runs.map { |target, _| File.basename(target, '.dart') }
  File.write(BATCH_ENTRYPOINT, <<~DART)
    // Generated by run_e2e_test: one CI batch's test files in one app process. Do not edit.
    // ignore_for_file: directives_ordering

    import 'support/stream_test_case.dart' show e2eTestFile;
    #{files.map { |file| "import '#{file}.dart' as #{file};" }.join("\n")}

    void main() {
    #{files.map { |file| "  e2eTestFile = '#{file}';\n  #{file}.main();" }.join("\n")}
    }
  DART

  names =
    unless runs.all? { |_, selected| selected.nil? }
      tests_of = E2ETests.list('integration_test').group_by { |id| E2ETests.file(id, 'integration_test') }
      runs.flat_map { |target, selected| selected || tests_of.fetch(target, []).map { |id| E2ETests.name(id) } }
    end
  [BATCH_ENTRYPOINT, names, files]
end

# The stripped output of an adb command, or nil when it fails or takes over [timeout]
# seconds. A frozen emulator can keep adb's connection open and still be listed as
# `device`, while every command sent to it hangs.
def adb_output(device, *args, timeout: 10)
  serial = device ? ['-s', device] : []
  reader, writer = IO.pipe
  pid = Process.spawn('adb', *serial, *args, out: writer, err: File::NULL)
  writer.close
  deadline = Time.now + timeout
  until (status = Process.wait2(pid, Process::WNOHANG)&.last)
    if Time.now > deadline
      Process.kill('KILL', pid) rescue nil
      Process.wait(pid) rescue nil
      return nil
    end
    sleep(0.2)
  end
  status.success? ? reader.read.strip : nil
ensure
  reader&.close
end

# Whether the Android device is online, after giving one that dropped off (e.g. a CI
# emulator that hung) a minute to come back.
def android_device_online?(device)
  6.times do |i|
    return true if adb_output(device, 'shell', 'echo', 'ok') == 'ok'

    UI.important("Android device #{device || '(default)'} is not responding; waiting for it to come back…") if i.zero?
    sleep(2)
  end
  false
end

# The AVD behind an emulator serial (e.g. emulator-5554), or nil for a physical device
# or one that is not answering.
def android_avd_name(device)
  return nil unless device.to_s.start_with?('emulator-')

  name = adb_output(device, 'emu', 'avd', 'name').to_s.lines.first.to_s.strip
  name.empty? || name == 'OK' ? nil : name
end

# Kills a dead emulator and cold-boots the same AVD on the same port, so a long run
# can carry on after the emulator hung (it does on CI, after an hour or more of tests).
# Returns whether the device is back.
def restart_android_emulator(device:, avd:)
  UI.important("Restarting emulator #{device} (#{avd})…")
  # Killed outright: `adb emu kill` hangs on a frozen emulator. The bracket keeps the
  # pattern from matching the shell that runs pkill, whose own command line holds it.
  sh("pkill -9 -f #{Shellwords.escape("[e]mulator.*-avd #{avd}")}", error_callback: ->(_) {})
  sleep(5)
  sh('adb reconnect offline', error_callback: ->(_) {})

  sdk = ENV['ANDROID_HOME'] || ENV['ANDROID_SDK_ROOT'] || File.expand_path('~/Library/Android/sdk')
  options = ENV['E2E_EMULATOR_OPTIONS'] || '-no-snapshot -no-window -no-audio -no-boot-anim -gpu swiftshader_indirect'
  log = "#{root_path}/build/emulator-restart.log"
  pid = Process.spawn(
    "#{sdk}/emulator/emulator -avd #{Shellwords.escape(avd)} -port #{device.delete_prefix('emulator-')} #{options}",
    out: [log, 'a'], err: [log, 'a'], pgroup: true,
  )
  Process.detach(pid)

  deadline = Time.now + 300
  until adb_output(device, 'shell', 'getprop', 'sys.boot_completed') == '1'
    if Time.now > deadline
      UI.error("Emulator #{device} did not boot within 5 minutes; see #{log}")
      return false
    end
    sleep(5)
  end

  # What android-emulator-runner does after its own boot.
  %w[window_animation_scale transition_animation_scale animator_duration_scale].each do |setting|
    sh("adb -s #{device} shell settings put global #{setting} 0.0")
  end
  sh("adb -s #{device} shell input keyevent 82")
  sh("adb -s #{device} logcat -c")
  true
end

# Whether the Android device is (back) online. On CI a dead emulator is restarted,
# up to [max_restarts] times per lane run.
def ensure_android_device(device:, avd:, restarts:, max_restarts: 3)
  return true if android_device_online?(device)
  return false unless is_ci && avd && restarts[:count] < max_restarts

  restarts[:count] += 1
  restart_android_emulator(device: device, avd: avd)
end

# How long one `flutter test` may run before the lane kills it: a build plus a generous
# allowance per test. A device that dies mid-run can leave `flutter test` waiting
# forever (seen on CI: the emulator went offline while coverage was being collected),
# and integration tests have no timeout of their own.
def run_time_limit(target, selected, files)
  tests =
    if selected
      selected.size
    else
      E2ETests.list('integration_test').count do |id|
        files.include?(File.basename(E2ETests.file(id, 'integration_test'), '.dart'))
      end
    end
  (15 + (2 * [tests, 1].max)) * 60
end

def boot_simulator(udid:)
  return if `xcrun simctl list devices booted`.to_s.include?(udid)
  return unless `xcrun simctl list devices`.to_s.include?(udid)

  sh("xcrun simctl bootstatus #{udid} -b")
end

# Video is recorded on ANDROID ONLY — iOS recording is intentionally disabled.
def start_screen_recording(ios:, device:, path:)
  return nil if ios

  FileUtils.mkdir_p(File.dirname(path))
  started_at_ms = (Time.now.to_f * 1000).round
  serial = device ? "-s #{device} " : ''
  remote = "/sdcard/#{File.basename(path)}"
  pid = spawn("adb #{serial}shell screenrecord --bit-rate 4000000 #{remote}",
              out: File::NULL, err: File::NULL)
  { pid: pid, path: path, remote: remote, device: device, started_at_ms: started_at_ms }
rescue StandardError => e
  UI.important("Screen recording failed to start: #{e.message}")
  nil
end

def stop_screen_recording(rec)
  return unless rec

  rec[:ended_at_ms] = (Time.now.to_f * 1000).round
  # Bounded: every call here hangs on a frozen device, which would hold the lane before
  # it can restart the emulator.
  adb_output(rec[:device], 'shell', 'pkill', '-INT', 'screenrecord')
  sleep(3) # let screenrecord finalize + flush the file on-device
  Process.kill('INT', rec[:pid]) rescue nil # reap the local adb client
  begin
    Timeout.timeout(5) { Process.wait(rec[:pid]) }
  rescue Timeout::Error
    Process.kill('KILL', rec[:pid]) rescue nil
    Process.wait(rec[:pid]) rescue nil
  rescue Errno::ECHILD
    nil
  end
  unless adb_output(rec[:device], 'shell', 'echo', 'ok') == 'ok'
    UI.important("Screen recording lost: the device is not responding (#{rec[:remote]})")
    return
  end
  unless adb_output(rec[:device], 'pull', rec[:remote], rec[:path], timeout: 120)
    UI.important("Screen recording could not be pulled from the device: #{rec[:remote]}")
  end
  adb_output(rec[:device], 'shell', 'rm', rec[:remote])
rescue StandardError => e
  UI.important("Screen recording failed to stop: #{e.message}")
end

def attach_videos_to_failed_results(results_dir:, videos:)
  return unless Dir.exist?(results_dir)
  return if videos.empty?

  unless system('command -v ffmpeg > /dev/null 2>&1')
    UI.important('ffmpeg not found; skipping per-test video attachments')
    return
  end

  Dir["#{results_dir}/*-result.json"].each do |json_path|
    result = JSON.parse(File.read(json_path))
    next unless %w[failed broken].include?(result['status'])
    next unless result['start'] && result['stop']

    label = (result['labels'] || []).find { |l| l['name'] == 'testFile' }
    recordings = label && videos[label['value']]
    next unless recordings

    meta = recordings.find do |r|
      r[:started_at_ms] && r[:ended_at_ms] &&
        result['start'] >= r[:started_at_ms] && result['start'] <= r[:ended_at_ms]
    end
    next unless meta && File.exist?(meta[:path]) && File.size(meta[:path]).positive?

    ss = [((result['start'] - meta[:started_at_ms]) / 1000.0) - 1.0, 0].max
    duration = ((result['stop'] - result['start']) / 1000.0) + 2.0
    next unless duration.positive?

    clip = "#{results_dir}/#{SecureRandom.uuid}-attachment.mp4"
    ok = system('ffmpeg', '-y', '-ss', ss.to_s, '-i', meta[:path], '-t', duration.to_s,
                '-an', '-c:v', 'libx264', '-preset', 'veryfast', '-movflags', '+faststart', clip,
                out: File::NULL, err: File::NULL)

    unless ok && File.exist?(clip) && File.size(clip) > 1024
      File.delete(clip) if File.exist?(clip)
      next
    end

    (result['attachments'] ||= []) << { 'name' => 'Video', 'source' => File.basename(clip), 'type' => 'video/mp4' }
    File.write(json_path, JSON.generate(result))
  end
end

lane :sh_on_root do |options|
  Dir.chdir(root_path) { sh(options[:command]) }
end

lane :fetch_dependencies do
  sh_on_root(command: "flutter pub get --suppress-analytics")
end

lane :start_mock_server do |options|
  Dir.chdir(root_path) do
    mock_server_repo = options[:local_server] || mock_server_repo_name
    stop_mock_server unless is_ci

    unless options[:local_server]
      branch = options[:branch].to_s.empty? ? 'main' : options[:branch]
      sh("rm -rf #{mock_server_repo}") if File.directory?(mock_server_repo)
      sh("git clone -b #{branch} https://github.com/#{github_repo.split('/').first}/#{mock_server_repo}.git")
    end

    Dir.chdir(mock_server_repo) do
      FileUtils.mkdir_p('logs')
      sh("bundle exec ruby driver.rb #{mock_server_driver_port} > logs/driver.log 2>&1 &")
    end
  end
end

lane :stop_mock_server do
  Net::HTTP.get_response(URI("http://localhost:#{mock_server_driver_port}/stop")) rescue nil
end

# Options: `selection` runs the tests select_e2e_tests chose (the file it wrote);
# `coverage` runs every test in its own app process and writes its lcov report
# to build/e2e-coverage/<test file>/<test>/, for build_e2e_coverage_map.
lane :run_e2e_test do |options|
  selection = options[:selection] && JSON.parse(File.read(File.expand_path(options[:selection], root_path)))
  next if selection && selection['tests'].empty?
  next unless selection || options[:coverage] || is_check_required(sources: @impact[:e2e][:sources], force_check: @force_check, required_checks: @impact[:e2e][:checks])

  ios = options[:platform] == 'ios' || ios_device?(options[:device])
  device = options[:device]
  coverage = options[:coverage]
  FileUtils.rm_rf(e2e_coverage_path) if coverage

  start_mock_server(local_server: options[:local_server], branch: options[:mock_server_branch])

  if ios
    device = prepare_simulator(device: options[:device], reset: is_ci, wait_for_boot: false)
  else
    serial = device ? "-s #{device} " : ''
    sh("adb #{serial}logcat -c")
    # Read while the emulator answers, so a dead one can be restarted with the same AVD.
    avd = android_avd_name(device)
    emulator_restarts = { count: 0 }
  end

  log_file = "#{root_path}/build/e2e-test.log"
  FileUtils.mkdir_p(File.dirname(log_file))
  File.write(log_file, '')

  videos_dir = "#{root_path}/build/e2e-videos"
  FileUtils.rm_rf(videos_dir)
  FileUtils.mkdir_p(videos_dir)
  videos = {} # test-file basename => [ { path:, started_at_ms:, ended_at_ms: }, ... ] (one per attempt)
  failed = []

  begin
    Dir.chdir(root_path) do
      runs =
        if coverage
          # The VM reports coverage per app process, so every test needs its own `flutter test`.
          E2ETests.list('integration_test', platform: ios ? 'ios' : 'android').map do |id|
            [E2ETests.file(id, 'integration_test'), [E2ETests.name(id)]]
          end
        elsif selection && !selection['run_all']
          selection['tests'].group_by { |id| E2ETests.file(id, 'integration_test') }
                            .map { |target, ids| [target, ids.map { |id| E2ETests.name(id) }] }
        else
          (options[:target] ? [options[:target]] : Dir['integration_test/*_test.dart'].sort).map { |target| [target, nil] }
        end
      UI.user_error!('No e2e test files found') if runs.empty?

      runs = batch_targets(runs, batch: options[:batch], batch_count: options[:batch_count])
      next if runs.empty?

      # Only CI batches share an app process; a whole-suite run keeps a fresh one per file.
      runs = [combine_runs(runs)] if !coverage && options[:batch_count].to_i > 1 && runs.size > 1

      retries = (options[:retries] || 2).to_i
      # GNU coreutils: present on the CI runners; on macOS only with coreutils installed.
      timeout_bin = `command -v timeout`.strip

      first_attempt = true
      runs.each_with_index do |(target, selected, files), run_index|
        test_name = File.basename(target, '.dart')
        files ||= [test_name]

        # A dead emulator turns every remaining run into an instant "No supported devices"
        # failure. If it can't be restarted, stop instead, and count the remaining runs as
        # failed, so the coverage map keeps their previous coverage rather than dropping them.
        if !ios && !ensure_android_device(device: device, avd: avd, restarts: emulator_restarts)
          remaining = runs.drop(run_index)
          UI.important("Android device #{device || '(default)'} is gone; skipping the #{remaining.size} remaining run(s)")
          remaining.each do |t, s, _|
            failed << (coverage ? "#{File.basename(t, '.dart')}/#{s.first}" : t)
          end
          break
        end

        attempt_log = "#{videos_dir}/#{test_name}.attempt.log"
        coverage_dir = "#{e2e_coverage_path}/#{test_name}/#{selected.first}" if coverage

        # nil => run the whole file (first attempt);
        # an array => run only those test descriptions.
        only = selected

        ok = false
        attempt = 0
        loop do
          boot_simulator(udid: device) if ios && !first_attempt
          first_attempt = false
          # The emulator may have died during the attempt being retried.
          if !ios && attempt.positive? && !ensure_android_device(device: device, avd: avd, restarts: emulator_restarts)
            break
          end

          attempt += 1

          flags = [target, '--no-pub', "--dart-define=E2E_TARGET=#{test_name}"]
          flags << "-d #{device}" if device

          if options[:verbose]
            flags << '--verbose'
          else
            flags << '--quiet'
            flags << "--reporter #{ENV['GITHUB_ACTIONS'] ? 'github' : 'expanded'}"
          end

          flags << "--name #{Shellwords.escape(E2ELog.name_alternation(only))}" if only
          if coverage
            flags << "--coverage --coverage-path #{Shellwords.escape("#{coverage_dir}/lcov.info")}"
            flags << "--coverage-package #{Shellwords.escape('^(e2e_app|stream_chat\w*)$')}"
          end
          # Per-run and per-attempt path so neither the next run of the same file
          # (one per test in coverage mode) nor a retry overwrites a recording.
          rec = start_screen_recording(ios: ios, device: device, path: "#{videos_dir}/#{test_name}.run#{run_index}.attempt#{attempt}.mp4")

          File.write(attempt_log, '')
          cmd = "flutter test #{flags.join(' ')} 2>&1 | tee -a #{Shellwords.escape(log_file)} | " \
                "tee #{Shellwords.escape(attempt_log)} | " \
                "{ grep --line-buffered -vE 'ALLURE-(RESULT|ATTACH)::|E2E-TEST::' || true; }"
          time_limit = run_time_limit(target, selected, files)
          # `timeout` signals its whole process group, so flutter and the tee pipeline go too.
          guard = timeout_bin.empty? ? '' : "#{timeout_bin} --kill-after=30 #{time_limit} "
          started_at = Time.now
          ok = begin
            sh("#{guard}bash -o pipefail -c #{Shellwords.escape(cmd)}")
            true
          rescue StandardError
            false
          end
          if !ok && !guard.empty? && Time.now - started_at >= time_limit
            UI.important("#{target} (attempt #{attempt}/#{retries + 1}): killed after #{time_limit / 60} min " \
                         'with no exit from flutter test; the device may have died')
          end

          stop_screen_recording(rec)

          # Keep every attempt's recording + window, so failed results from an
          # earlier attempt still match their own video even when a later retry
          # narrows the test set or passes.
          # A batch's recording covers each of its files.
          if rec
            files.each do |file|
              (videos[file] ||= []) << {
                path: rec[:path],
                started_at_ms: rec[:started_at_ms],
                ended_at_ms: rec[:ended_at_ms],
              }
            end
          end

          # A run that reports tests it never ran must not go green, however
          # `flutter test` exited. Also the best retry target when there is no
          # failure to attribute — those are exactly the tests still owed a result.
          phantom = E2ELog.phantom_test_names(attempt_log)
          unless phantom.empty?
            ok = false
            UI.important("#{target}: #{phantom.size} test(s) reported without ever running " \
                         "(no result emitted): #{phantom.join(', ')}")
          end

          break if ok || attempt > retries

          # A device that died mid-run also fails the run "after test completion" (the
          # coverage collector loses the app), but that is retriable once the emulator
          # is back, which the next attempt takes care of.
          device_lost = !ios && adb_output(device, 'shell', 'echo', 'ok') != 'ok'
          UI.important("#{target} (attempt #{attempt}/#{retries + 1}): the device stopped responding") if device_lost

          # Not retriable: a whole-file retry can neither narrow nor fix a leaked
          # async error, and a run that happens to pass would only be hiding it.
          # Fail fast with the diagnosis instead of burning every attempt.
          if !device_lost && E2ELog.post_completion_failure?(attempt_log)
            blamed = E2ELog.post_completion_blamed_tests(attempt_log)
            UI.important("#{target} (attempt #{attempt}/#{retries + 1}): a test leaked async work that threw " \
                         'AFTER it had completed, so the failure is not attributable to any single test' \
                         "#{blamed.empty? ? '' : " (the runner blamed: #{blamed.join(', ')})"}. " \
                         'Not retrying — fix the leak; see the exception above.')
            break
          end

          # Both sets, not just the attributable ones: an attempt that reports a
          # failure *and* phantoms would otherwise retry the failure alone, and a
          # green retry of that one test would bury the tests still owed a result.
          only = (E2ELog.failed_test_names(attempt_log) + phantom).uniq
          if only.empty?
            only = selected
            UI.important("#{target} failed (attempt #{attempt}/#{retries + 1}); " \
                         "retrying #{selected ? 'the selected tests' : 'whole file'}…")
          else
            UI.important("#{target} failed (attempt #{attempt}/#{retries + 1}); " \
                         "retrying #{only.size} failed test(s): #{only.join(', ')}")
          end
        end

        if coverage
          # A test that never reported a result (skipped, or the app died first) ran no test code.
          FileUtils.rm_rf(coverage_dir) unless E2ELog.reported_test_names(attempt_log).include?(selected.first)
          failed << "#{test_name}/#{selected.first}" unless ok
        elsif !ok
          # A batch names the tests that still fail, not every file it ran.
          still_failing = (E2ELog.failed_test_names(attempt_log) + E2ELog.phantom_test_names(attempt_log)).uniq
          failed.concat(files.size > 1 && !still_failing.empty? ? still_failing : [target])
        end
      end

      UI.user_error!("E2E failed after retries: #{failed.join(', ')}") unless failed.empty?
    end
  ensure
    # build_e2e_coverage_map keeps the previous coverage of these, as a failed test stops early.
    if coverage
      FileUtils.mkdir_p(e2e_coverage_path)
      File.write("#{e2e_coverage_path}/failed_tests_#{options[:batch] || 0}.json", JSON.generate(failed))
    end
    collect_allure_results(log_file: log_file) rescue nil
    File.write("#{videos_dir}/manifest.json", JSON.generate(videos)) unless videos.empty?
    stop_mock_server
  end
end

lane :attach_videos do
  manifest = "#{root_path}/build/e2e-videos/manifest.json"
  unless File.exist?(manifest)
    UI.important("No video manifest at #{manifest}; nothing to attach")
    next
  end

  videos = JSON.parse(File.read(manifest)).transform_values do |recordings|
    recordings.map do |v|
      { path: v['path'], started_at_ms: v['started_at_ms'], ended_at_ms: v['ended_at_ms'] }
    end
  end
  attach_videos_to_failed_results(results_dir: allure_results_path, videos: videos)
end

# Picks the e2e tests a pull request can affect from the nightly coverage map and
# writes them to build/e2e_selection.json for `run_e2e_test selection:`. Outputs
# `e2e_batches`, the batch matrix of the e2e jobs (empty when nothing runs).
lane :select_e2e_tests do |options|
  # A manual run's tip may be a merge commit, which the selection would mistake for a pull request merge.
  run_all_reason = 'not a pull request' if is_ci && ENV['GITHUB_EVENT_NAME'] != 'pull_request'
  required = run_all_reason || is_check_required(sources: @impact[:e2e][:sources], force_check: @force_check, required_checks: @impact[:e2e][:checks])
  all_tests = required ? E2ETests.list("#{root_path}/integration_test") : []

  if run_all_reason
    UI.important("Running all #{all_tests.size} tests: #{run_all_reason}")
    selection = { 'run_all' => true, 'tests' => all_tests, 'reasons' => [run_all_reason] }
  elsif required
    selection = select_impacted_tests(
      all_tests: all_tests,
      # Relative to e2e_app, like `run_e2e_test selection:`; the action itself reads from the repository root.
      coverage_map: options[:coverage_map] && File.expand_path(options[:coverage_map], root_path),
      coverage_map_artifact: e2e_coverage_map_artifact,
      coverage_map_branch: 'master',
      diff_base: options[:diff_base],
      changed_files: options[:changed_files]&.split(','),
      source_root: repo_root,
      source_paths: ['e2e_app/lib', 'packages/*/lib/**/*'],
      test_paths: ['e2e_app/integration_test/*_test.dart'],
      ignore_paths: ['**/*.md'],
      run_all_paths: [
        'e2e_app/integration_test/allure',
        'e2e_app/integration_test/mock_server',
        'e2e_app/integration_test/pages',
        'e2e_app/integration_test/robots',
        'e2e_app/integration_test/support',
        'e2e_app/android',
        'e2e_app/ios',
        'e2e_app/pubspec.yaml'
      ],
      # Changes to code nearly every test runs (launch, login, channel list) take one test per file; the nightly run covers the rest.
      hot_test_ratio: 0.9
    )
  else
    selection = { 'run_all' => false, 'tests' => [], 'reasons' => ['no e2e sources changed'] }
  end
  FileUtils.mkdir_p(File.dirname(e2e_selection_path))
  File.write(e2e_selection_path, JSON.pretty_generate(selection))

  # run_e2e_test batches by test file, so there are no more batches than files.
  files = selection['tests'].map { |id| E2ETests.file(id, 'integration_test') }.uniq
  batches = (0...[files.size, 8].min).to_a
  UI.important("E2E batches: #{batches.size}")
  File.write(ENV['GITHUB_OUTPUT'], "e2e_batches=#{batches.to_json}\n", mode: 'a') if ENV['GITHUB_OUTPUT']
  batches
end

# Builds the coverage map select_e2e_tests reads from the lcov reports of
# `run_e2e_test coverage:true` (every batch's, merged into one folder on CI).
lane :build_e2e_coverage_map do |options|
  coverage_dir = options[:coverage_dir] ? File.expand_path(options[:coverage_dir], root_path) : e2e_coverage_path
  failed_tests = Dir["#{coverage_dir}/failed_tests_*.json"].flat_map { |file| JSON.parse(File.read(file)) }
  build_test_coverage_map(
    coverage_dir: coverage_dir,
    lcov_base_dir: root_path,
    source_root: repo_root,
    output_path: "#{root_path}/build/e2e_coverage_map.json",
    failed_tests: failed_tests,
    previous_map_artifact: e2e_coverage_map_artifact,
    previous_map_branch: 'master'
  )
end

# What each gated check runs on: a pull request runs it when `sources` changed, or
# when its `checks` have not passed yet on a commit with the current sources.
lane :impact_analysis do
  {
    e2e: {
      sources: ['e2e_app', 'packages'],
      checks: ['E2E result']
    }
  }
end

lane :install_runtime do |options|
  install_ios_runtime(
    version: options[:ios],
    custom_script: File.join(root_path, 'scripts/install_ios_runtime.sh'),
  )
end
